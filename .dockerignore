# Исключаем служебные файлы Git
.git
.gitignore

# Исключаем локальные секреты и переменные окружения
.env
.env.local

# Исключаем кэш Python и виртуальные окружения
__pycache__/
*.pyc
.venv/
venv/
env/

# Исключаем настройки редакторов
.idea/
.vscode/

# Исключаем тяжелую документацию и схемы, не нужные для работы сервера
README.md
ARCHITECTURE.md
openapi.yaml
*.png
